@page "/seller/dashboard"
@using SD.Mercato.UI.Client.Services
@inject ISellerDashboardService DashboardService
@inject IStoreService StoreService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<SellerDashboard> Logger
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Seller")]

<PageTitle>Seller Dashboard - Mercato</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Seller Dashboard</h1>
        <div class="text-muted">
            Seller Panel
        </div>
    </div>

    @if (storeId == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> You don't have an active store. Please set up your store first.
        </div>
    }
    else
    {
        <!-- Period Selection -->
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title mb-3">Select Period</h5>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="periodType" class="form-label">Period Type</label>
                        <select id="periodType" class="form-select" @bind="periodType" @bind:after="OnPeriodTypeChanged">
                            <option value="today">Today</option>
                            <option value="yesterday">Yesterday</option>
                            <option value="last7Days">Last 7 Days</option>
                            <option value="thisMonth">This Month</option>
                            <option value="lastMonth">Last Month</option>
                            <option value="last3Months">Last 3 Months</option>
                            <option value="custom">Custom Range</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date" id="startDate" class="form-control" @bind="startDate" disabled="@(periodType != "custom")" />
                    </div>
                    <div class="col-md-3">
                        <label for="endDate" class="form-label">End Date</label>
                        <input type="date" id="endDate" class="form-control" @bind="endDate" disabled="@(periodType != "custom")" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="LoadMetrics">
                            <i class="bi bi-search"></i> Load Dashboard
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading dashboard metrics...</p>
            </div>
        }
        else if (metrics != null)
        {
            <!-- Sales Overview -->
            <div class="row mb-4">
                <div class="col-12">
                    <h5 class="mb-3">Sales Overview</h5>
                    <small class="text-muted">@metrics.PeriodStartDate.ToString("yyyy-MM-dd") to @metrics.PeriodEndDate.ToString("yyyy-MM-dd")</small>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card border-success">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-1">Total Sales</h6>
                                    <h3 class="mb-0 text-success">@metrics.TotalSales.ToString("C2")</h3>
                                </div>
                                <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-currency-dollar fs-3 text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-1">Number of Orders</h6>
                                    <h3 class="mb-0 text-primary">@metrics.OrderCount</h3>
                                </div>
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-box-seam fs-3 text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Best Selling Products -->
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Best Selling Products</h5>
                </div>
                <div class="card-body">
                    @if (metrics.BestSellingProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Quantity Sold</th>
                                        <th class="text-end">Total Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in metrics.BestSellingProducts)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(product.ProductImageUrl))
                                                    {
                                                        <img src="@product.ProductImageUrl" 
                                                             alt="@product.ProductTitle" 
                                                             class="img-thumbnail me-3" 
                                                             style="width: 50px; height: 50px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light border me-3 d-flex align-items-center justify-content-center" 
                                                             style="width: 50px; height: 50px;">
                                                            <i class="bi bi-image text-muted"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <div class="fw-bold">@product.ProductTitle</div>
                                                        <small class="text-muted">SKU: @product.ProductSku</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-primary">@product.QuantitySold</span>
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                @product.TotalRevenue.ToString("C2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No sales in the selected period.</p>
                    }
                </div>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i> @errorMessage
            </div>
        }
    }
</div>

@code {
    private Guid? storeId = null;
    private string periodType = "thisMonth";
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private bool isLoading = false;
    private string? errorMessage = null;
    private SellerDashboardMetrics? metrics = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadStoreId();
        OnPeriodTypeChanged();
        if (storeId.HasValue)
        {
            await LoadMetrics();
        }
    }

    private async Task LoadStoreId()
    {
        try
        {
            var stores = await StoreService.GetActiveStoresAsync();
            if (stores != null && stores.Any())
            {
                // MVP assumes one active store per seller
                // Use Skip(1).Any() for efficient multiple stores detection
                if (stores.Skip(1).Any())
                {
                    Logger.LogWarning(
                        "Seller has multiple active stores. StoreCount: {StoreCount}", 
                        stores.Count);
                    errorMessage = "Data error: Multiple active stores detected for your account. Please contact support.";
                    storeId = null;
                }
                else
                {
                    storeId = stores.First().Id;
                }
            }
            
            if (!storeId.HasValue)
            {
                errorMessage = "You don't have an active store. Please set up your store first.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load store");
            errorMessage = "Failed to load store information";
        }
    }

    private void OnPeriodTypeChanged()
    {
        var today = DateTime.Today;
        switch (periodType)
        {
            case "today":
                startDate = today;
                endDate = today;
                break;
            case "yesterday":
                startDate = today.AddDays(-1);
                endDate = today.AddDays(-1);
                break;
            case "last7Days":
                startDate = today.AddDays(-7);
                endDate = today;
                break;
            case "thisMonth":
                startDate = new DateTime(today.Year, today.Month, 1);
                endDate = today;
                break;
            case "lastMonth":
                var lastMonth = today.AddMonths(-1);
                startDate = new DateTime(lastMonth.Year, lastMonth.Month, 1);
                endDate = startDate.AddMonths(1).AddDays(-1);
                break;
            case "last3Months":
                startDate = today.AddMonths(-3);
                endDate = today;
                break;
            // "custom" doesn't change the dates
        }
    }

    private async Task LoadMetrics()
    {
        if (!storeId.HasValue)
        {
            errorMessage = "No store found";
            return;
        }

        isLoading = true;
        errorMessage = null;
        metrics = null;

        try
        {
            metrics = await DashboardService.GetDashboardMetricsAsync(
                storeId.Value, 
                startDate, 
                endDate);

            if (metrics == null)
            {
                errorMessage = "Failed to load dashboard metrics. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading dashboard: {ex.Message}";
            Logger.LogError(ex, "Failed to load seller dashboard metrics");
        }
        finally
        {
            isLoading = false;
        }
    }
}
