@page "/"
@using SD.Mercato.UI.Client.Services
@using SD.Mercato.UI.Client.Components
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject ICartService CartService
@inject NavigationManager Navigation
@layout BuyerLayout

<PageTitle>Mercato - Your Multi-Vendor Marketplace</PageTitle>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">Discover Amazing Products</h1>
            <p class="hero-subtitle">Shop from trusted sellers across our marketplace</p>
            <div class="hero-search">
                <div class="search-bar-large">
                    <i class="bi bi-search"></i>
                    <input type="text" 
                           placeholder="What are you looking for today?" 
                           @bind="searchQuery"
                           @bind:event="oninput"
                           @onkeypress="HandleSearchKeyPress" />
                    <button class="search-button" @onclick="PerformSearch">Search</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section">
    <div class="container">
        <div class="section-header">
            <h2>Shop by Category</h2>
            <p>Explore our wide range of product categories</p>
        </div>
        
        @if (loadingCategories)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading categories...</span>
                </div>
            </div>
        }
        else
        {
            <div class="categories-grid">
                @foreach (var category in featuredCategories)
                {
                    <CategoryCard 
                        CategoryId="@category.Id" 
                        Name="@category.Name" 
                        IconClass="@GetCategoryIcon(category.Name)" />
                }
            </div>
        }
        
        <div class="section-footer">
            <a href="/catalog" class="btn-view-all">View All Products</a>
        </div>
    </div>
</section>

<!-- Popular Products Section -->
<section class="products-section">
    <div class="container">
        <div class="section-header">
            <h2>Popular Products</h2>
            <p>Best-selling items loved by our customers</p>
        </div>
        
        @if (loadingPopular)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading products...</span>
                </div>
            </div>
        }
        else if (popularProducts.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>No products available yet</p>
            </div>
        }
        else
        {
            <div class="products-grid">
                @foreach (var product in popularProducts)
                {
                    <ProductCard 
                        Product="@product" 
                        ShowAddToCart="true" 
                        OnAddToCart="HandleAddToCart" />
                }
            </div>
        }
    </div>
</section>

<!-- New Arrivals Section -->
<section class="products-section bg-light">
    <div class="container">
        <div class="section-header">
            <h2>New Arrivals</h2>
            <p>Fresh products just added to our marketplace</p>
        </div>
        
        @if (loadingNewArrivals)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading products...</span>
                </div>
            </div>
        }
        else if (newArrivals.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>No new arrivals yet</p>
            </div>
        }
        else
        {
            <div class="products-grid">
                @foreach (var product in newArrivals)
                {
                    <ProductCard 
                        Product="@product" 
                        ShowAddToCart="true" 
                        OnAddToCart="HandleAddToCart" />
                }
            </div>
        }
    </div>
</section>

@code {
    private List<CategoryDto> featuredCategories = new();
    private List<PublicProductDto> popularProducts = new();
    private List<PublicProductDto> newArrivals = new();
    private string searchQuery = string.Empty;
    
    private bool loadingCategories = true;
    private bool loadingPopular = true;
    private bool loadingNewArrivals = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadCategoriesAsync(),
            LoadPopularProductsAsync(),
            LoadNewArrivalsAsync()
        );
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            var allCategories = await CategoryService.GetActiveCategoriesAsync();
            // Show up to 6 top-level categories
            featuredCategories = allCategories
                .Where(c => c.ParentCategoryId == null)
                .Take(6)
                .ToList();
        }
        catch (Exception ex)
        {
            // TODO: Log error and show user-friendly message
            Console.WriteLine($"Error loading categories: {ex.Message}");
        }
        finally
        {
            loadingCategories = false;
        }
    }

    private async Task LoadPopularProductsAsync()
    {
        try
        {
            // TODO: Implement proper popularity sorting based on sales/views
            // For now, we'll get recent products sorted by creation date descending
            var request = new ProductSearchRequest
            {
                PageNumber = 1,
                PageSize = 8,
                SortBy = "created",
                SortDirection = "desc"
            };
            
            var response = await ProductService.SearchProductsAsync(request);
            popularProducts = response.Products.Take(8).ToList();
        }
        catch (Exception ex)
        {
            // TODO: Log error and show user-friendly message
            Console.WriteLine($"Error loading popular products: {ex.Message}");
        }
        finally
        {
            loadingPopular = false;
        }
    }

    private async Task LoadNewArrivalsAsync()
    {
        try
        {
            var request = new ProductSearchRequest
            {
                PageNumber = 1,
                PageSize = 8,
                SortBy = "created",
                SortDirection = "desc"
            };
            
            var response = await ProductService.SearchProductsAsync(request);
            newArrivals = response.Products.Take(8).ToList();
        }
        catch (Exception ex)
        {
            // TODO: Log error and show user-friendly message
            Console.WriteLine($"Error loading new arrivals: {ex.Message}");
        }
        finally
        {
            loadingNewArrivals = false;
        }
    }

    private async Task HandleAddToCart(Guid productId)
    {
        try
        {
            await CartService.AddItemAsync(new AddToCartRequest
            {
                ProductId = productId,
                Quantity = 1
            });
            // TODO: Show success notification
        }
        catch (Exception ex)
        {
            // TODO: Show error notification
            Console.WriteLine($"Error adding to cart: {ex.Message}");
        }
    }

    private void HandleSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            PerformSearch();
        }
    }

    private void PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            Navigation.NavigateTo($"/catalog?search={Uri.EscapeDataString(searchQuery)}");
        }
    }

    private string GetCategoryIcon(string categoryName)
    {
        // TODO: This is a simple mapping. In production, store icon names with categories in the database
        return categoryName.ToLower() switch
        {
            var name when name.Contains("electronic") => "bi-laptop",
            var name when name.Contains("fashion") || name.Contains("clothing") => "bi-bag",
            var name when name.Contains("home") || name.Contains("furniture") => "bi-house",
            var name when name.Contains("book") => "bi-book",
            var name when name.Contains("sport") || name.Contains("fitness") => "bi-trophy",
            var name when name.Contains("toy") || name.Contains("game") => "bi-controller",
            var name when name.Contains("food") || name.Contains("grocery") => "bi-basket",
            var name when name.Contains("beauty") || name.Contains("health") => "bi-heart-pulse",
            _ => "bi-grid-3x3"
        };
    }
}
